[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
textures/stretch/aspect="keep"
textures/size/window_height_override=720
textures/size/window_width_override=1080
textures/size/borderless=false
textures/size/viewport_height=1080
textures/size/viewport_width=1920
textures/stretch/mode="canvas_items"
textures/size/mode=0
