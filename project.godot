; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="gameseed-project"
run/main_scene="uid://b4ocayp5xdca"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
SceneManager="*res://scripts/systems/scene_manager.gd"
GameState="*res://scripts/systems/game_state.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
SettingsManager="*res://scripts/systems/settings_manager.gd"
AudioManager="*res://scenes/systems/audio_manager.tscn"
CursorManager="*res://scripts/systems/cursor_manager.gd"

[dialogic]

directories/dch_directory={
"bocah lumpur": "res://characters/bocah_lumpur.dch",
"ksatria naga": "res://characters/ksatria_naga.dch",
"monster debu": "res://characters/monster_debu.dch",
"mystery child": "res://characters/mystery_child.dch",
"pak guyon": "res://characters/pak_guyon.dch",
"pegawai kantoran": "res://characters/pegawai_kantoran.dch",
"pegawai_bayangan": "res://characters/pegawai_bayangan.dch"
}
directories/dtl_directory={
"01_bocah_lumpur": "res://resources/dialog/01_bocah_lumpur.dtl",
"02_ksatria_naga": "res://resources/dialog/02_ksatria_naga.dtl",
"03_pegawai_kantoran": "res://resources/dialog/03_pegawai_kantoran.dtl",
"04_monster_debu": "res://resources/dialog/04_monster_debu.dtl",
"05_mystery_child": "res://resources/dialog/05_mystery_child.dtl",
"closing": "res://resources/dialog/closing.dtl",
"intro_scene": "res://resources/dialog/intro_scene.dtl"
}
layout/style_directory={
"": "res://assets/shaders/Custom_Dialog_Box/New_File.tres",
"New_File": "res://assets/shaders/Custom_Dialog_Box/New_File.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://assets/shaders/Custom_Dialog_Box/New_File.tres"]
layout/default_style="res://assets/shaders/Custom_Dialog_Box/New_File.tres"
variables={}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.05
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autocolor_names=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1080
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="gameseed-project"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[gui]

theme/custom_font="uid://bgcqkkaapqw35"

