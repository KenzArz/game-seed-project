intro_lines = PackedStringArray("...halo.", "Aku... nggak tahu aku mau apa. Aku cuma merasa kurang... cukup.", "Buatkan saja apa yang menurut kakak baik untukku ya.")
react_perfect = PackedStringArray("...ini hangat sekali.", "Untuk pertama kalinya, aku merasa... aku cukup, apa adanya.", "Terima kasih sudah meracikku dengan sepenuh hati.")
