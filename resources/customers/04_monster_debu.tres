[gd_resource type="Resource" script_class="CustomerData" format=3]

[ext_resource type="Script" path="res://scripts/systems/customer_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "monster_debu"
display_name = "Monster Debu"
npc_color = Color(0.5, 0.5, 0.45, 1)
available_ingredients = PackedStringArray("sabun", "shampo", "pasta", "bedak", "mint", "garam")
recipe = PackedStringArray("sabun", "shampo", "garam")
result_perfect = "Ocean Cloud"
result_partial = "Busa Setengah Jadi"
result_wrong = "Debu Berbusa"
intro_lines = PackedStringArray("JANGAN PANIK. Aku cuma mau bersih.", "Aku sudah lama tidak benar-benar bersih. Debu ini menempel terlalu lama.", "Aku butuh yang [color=#C9A84C]kuat[/color], yang bisa [color=#C9A84C]membersihkan sampai dalam[/color]. Bukan cuma di permukaan.", "Tapi [color=#C9A84C]bukan yang dingin[/color], aku sudah cukup kedinginan. Kasih yang ada [color=#C9A84C]efek ombak[/color]-nya!", "(Pak Guyon serius) Membersihkan sampai dalam, efek ombak... Ada bahan baru yang rasanya seperti laut. Lihat rak.")
react_perfect = PackedStringArray("...Ombaknya menyapu semua debuku. Terima kasih.", "Waktu kecil aku suka garam laut. Seperti laut tahu cara membersihkan sesuatu yang jauh lebih besar dari dirinya.")
react_partial = PackedStringArray("Grr, sebagian debu masih nempel!", "Butuh yang lebih kuat membersihkan... garam jangan lupa!")
react_wrong = PackedStringArray("GROAAR! Debuku malah nggak hilang!", "Aku mau yang KUAT bersih-bersihnya! Garam!")
background_color = Color(0.15, 0.15, 0.14, 1)
