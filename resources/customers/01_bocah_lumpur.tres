intro_lines = PackedStringArray("Kak! Kak! Aku abis main di sungai, liat lumpurnya sebanyak ini!", "Ibu bilang aku harus bersih sebelum makan. Busanya harus [color=#C9A84C]banyak gelembungnya[/color] biar lumpurnya keangkat!", "Aku mau yang [color=#C9A84C]cepet hilang busanya[/color] juga, biar bisa balik main lagi!", "(Pak Guyon berbisik) Banyak gelembung, cepat hilang... bahan apa yang paling suka bikin ribut di permukaan air?")
react_perfect = PackedStringArray("Enak banget! Busanya banyak gelembungnya!", "Oh iya Kak, tadi aku ngunyah daun mint, nafasku jadi sejuk banget! Kayak es dari dalem!")
react_partial = PackedStringArray("Hmm, gelembungnya kurang banyak nih Kak...", "Coba tambah yang suka bikin busa rame ya!")
react_wrong = PackedStringArray("Lho kok nggak ada gelembungnya? Aku kan mau yang rame busanya, Kak.")
