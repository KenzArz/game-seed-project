intro_lines = PackedStringArray("Kakak! Kakak! Aku abis main lumpur seharian, badanku kotor semua hihi!", "Aku mau [color=#FFD700]busa tebal[/color] yang [color=#FFD700]banyak gelembungnya[/color], biar bisa kuterbangin tinggi!", "Terus yang [color=#FFD700]seger[/color] juga ya, biar besok aku semangat main lagi!")
