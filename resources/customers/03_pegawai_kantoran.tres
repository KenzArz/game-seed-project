[gd_resource type="Resource" script_class="CustomerData" format=3]

[ext_resource type="Script" path="res://scripts/systems/customer_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "pegawai_kantoran"
display_name = "Pegawai Kantoran"
npc_color = Color(0.4, 0.45, 0.55, 1)
available_ingredients = PackedStringArray("sabun", "shampo", "pasta", "bedak")
recipe = PackedStringArray("sabun", "shampo", "bedak")
result_perfect = "Comfort Cloud"
result_partial = "Busa Setengah Jadi"
result_wrong = "Busa Kasar"
intro_lines = PackedStringArray("Maaf kalau aku tidak banyak bicara. Aku sudah lelah bicara seharian.", "Yang aku mau simple. Aku mau merasa seperti [color=#C9A84C]dipeluk[/color]. [color=#C9A84C]Hangat[/color]. [color=#C9A84C]Lembut banget[/color].", "Kalau bisa yang ada [color=#C9A84C]aroma nyaman[/color]-nya. Bukan yang terlalu keras.", "(Pak Guyon pelan) Dia butuh yang lembut dan menenangkan. Kamu tahu kan bahan paling lembut yang ada sekarang?")
react_perfect = PackedStringArray("Hngg... lembut sekali. Bahuku terasa ringan.", "Dulu aku suka main daun-daun rontok di ember saat mandi. Aroma hijaunya bikin dunia terasa lebih aman...")
react_partial = PackedStringArray("Lumayan... tapi masih kurang menenangkan.", "Tambahkan yang lembut ya, biar capeknya hilang.")
react_wrong = PackedStringArray("Aduh, ini malah bikin badanku makin tegang.", "Aku butuh yang lembut dan hangat, bukan ini.")
background_color = Color(0.14, 0.15, 0.18, 1)
